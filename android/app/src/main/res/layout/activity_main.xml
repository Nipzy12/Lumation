<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumation_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="LUMATION"
                android:textColor="@color/lumation_text"
                android:textSize="23sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOTION EDITOR · v0.7"
                android:textColor="@color/lumation_accent"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp">
            <Button
                android:id="@+id/saveProjectButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:enabled="false"
                android:backgroundTint="@color/lumation_surface"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/loadProjectButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="Projects"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
        </LinearLayout>
        <TextView
            android:id="@+id/projectNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:text="Project: Belum disimpan"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp">
            <Button
                android:id="@+id/newProjectButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="+ New"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/saveAsProjectButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="Save As"
                android:enabled="false"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/deleteProjectButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="Delete"
                android:enabled="false"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="292dp"
            android:background="#05060C">
            <VideoView
                android:id="@+id/videoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
            <com.lumavun.lumation.MotionOverlayView
                android:id="@+id/motionPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <TextView
                android:id="@+id/emptyPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="28dp"
                android:text="✦\n\nPilih video untuk mulai mengedit"
                android:textColor="@color/lumation_muted"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:padding="12dp"
                android:text="PREVIEW"
                android:textColor="#B9A8FF"
                android:textSize="11sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/fileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Belum ada klip"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/importButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_accent"
                android:text="+ Media"
                android:textAllCaps="false"
                android:textColor="#141124" />
            <Button
                android:id="@+id/playButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="0.7"
                android:enabled="false"
                android:backgroundTint="@color/lumation_surface"
                android:text="▶ Play"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/exportButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:enabled="false"
                android:backgroundTint="#8266FC"
                android:text="Export MP4"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="14dp">
            <Button
                android:id="@+id/audioImportButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="+ Audio"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/audioRemoveButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:enabled="false"
                android:text="× Hapus audio"
                android:textAllCaps="false"
                android:textColor="@color/lumation_muted" />
        </LinearLayout>
        <TextView
            android:id="@+id/audioFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Audio track belum ditambahkan"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/audioVolumeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volume musik: 60%"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />
        <SeekBar
            android:id="@+id/audioVolumeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:max="100"
            android:progress="60"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">
            <Button
                android:id="@+id/undoButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:enabled="false"
                android:text="↶ Undo"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/redoButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:enabled="false"
                android:text="↷ Redo"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:text="QUICK COMMAND · MANUAL / AI SUGGESTION"
            android:textColor="@color/lumation_muted"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/offlineCommandInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:maxLength="256"
                android:hint="geser kanan | naik | teks: Halo"
                android:textSize="13sp"
                android:inputType="text"
                android:backgroundTint="@color/lumation_accent"
                android:textColor="@color/lumation_text"
                android:textColorHint="@color/lumation_muted" />
            <Button
                android:id="@+id/applyCommandButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/lumation_accent"
                android:text="Apply"
                android:textAllCaps="false"
                android:textColor="#141124" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:paddingBottom="6dp"
            android:text="LOCAL AI · GGUF / LLAMA.CPP"
            android:textColor="@color/lumation_accent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/ggufModelLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Model GGUF belum dipasang"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/importGgufButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="Import GGUF"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/loadGgufButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:enabled="false"
                android:backgroundTint="@color/lumation_surface"
                android:text="Load Model"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/unloadGgufButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:enabled="false"
                android:backgroundTint="@color/lumation_surface"
                android:text="Unload"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/aiSuggestButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="2"
                android:enabled="false"
                android:backgroundTint="@color/lumation_accent"
                android:text="AI Suggest (Offline)"
                android:textAllCaps="false"
                android:textColor="#141124" />
            <Button
                android:id="@+id/deleteGgufButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:backgroundTint="@color/lumation_surface"
                android:text="Remove GGUF"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
        </LinearLayout>
        <TextView
            android:id="@+id/aiResponseLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Ketik prompt di Quick Command, tekan AI Suggest, periksa saran, lalu Apply."
            android:textColor="@color/lumation_muted"
            android:textSize="11sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp"
            android:paddingBottom="8dp"
            android:text="MOTION LAYERS  •  TEXT &amp; IMAGE"
            android:textColor="@color/lumation_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/overlayTextInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:maxLength="64"
                android:hint="Tulis teks animasi..."
                android:inputType="textCapSentences"
                android:textSize="14sp"
                android:paddingHorizontal="12dp"
                android:backgroundTint="@color/lumation_accent"
                android:textColor="@color/lumation_text"
                android:textColorHint="@color/lumation_muted" />
            <Button
                android:id="@+id/applyTextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="7dp"
                android:backgroundTint="@color/lumation_accent"
                android:text="Set Text"
                android:textAllCaps="false"
                android:textColor="#151128" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/imageImportButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="+ Image"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/imageRemoveButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:backgroundTint="@color/lumation_surface"
                android:text="× Remove Image"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/textRemoveButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="× Text"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/selectTextLayer"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_accent"
                android:text="Edit TEXT"
                android:textAllCaps="false"
                android:textColor="#151128" />
            <Button
                android:id="@+id/selectImageLayer"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="Edit IMAGE"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/presetSlideButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="Slide →"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/presetRiseButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="Rise ↑"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/presetStillButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_surface"
                android:text="Static"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
        </LinearLayout>
        <TextView
            android:id="@+id/layerValueLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="TEXT · Start (50%,50%) → End (50%,50%) · Scale 100%"
            android:textColor="@color/lumation_muted"
            android:textSize="11sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start keyframe: X / Y"
            android:textColor="@color/lumation_text"
            android:textSize="11sp" />
        <SeekBar
            android:id="@+id/layerStartX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />
        <SeekBar
            android:id="@+id/layerStartY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End keyframe: X / Y"
            android:textColor="@color/lumation_text"
            android:textSize="11sp" />
        <SeekBar
            android:id="@+id/layerEndX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />
        <SeekBar
            android:id="@+id/layerEndY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Layer scale"
            android:textColor="@color/lumation_text"
            android:textSize="11sp" />
        <SeekBar
            android:id="@+id/layerScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="40"
            android:max="180"
            android:progress="100"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="22dp"
            android:paddingBottom="10dp"
            android:text="TIMELINE  •  VIDEO + AUDIO + TEXT + IMAGE"
            android:textColor="@color/lumation_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <com.lumavun.lumation.TimelineView
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="238dp"
            android:background="@color/lumation_surface" />

        <TextView
            android:id="@+id/timeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingTop="8dp"
            android:text="00:00.0 / 00:00.0"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="TRIM CLIP"
            android:textColor="@color/lumation_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/startLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Mulai: 00:00.0"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/startSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />

        <TextView
            android:id="@+id/endLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selesai: 00:00.0"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/endSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="1000"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />

        <ProgressBar
            android:id="@+id/exportProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:indeterminateTint="@color/lumation_accent" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:text="Offline • Audio track &amp; ekspor di perangkat • Offline project save &amp; motion layers · AI belum tersedia"
            android:textColor="@color/lumation_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
