<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumation_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="LUMATION"
                android:textColor="@color/lumation_text"
                android:textSize="23sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOTION EDITOR · v0.1"
                android:textColor="@color/lumation_accent"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="292dp"
            android:background="#05060C">
            <VideoView
                android:id="@+id/videoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
            <TextView
                android:id="@+id/emptyPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="28dp"
                android:text="✦\n\nPilih video untuk mulai mengedit"
                android:textColor="@color/lumation_muted"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:padding="12dp"
                android:text="PREVIEW"
                android:textColor="#B9A8FF"
                android:textSize="11sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/fileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Belum ada klip"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/importButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:backgroundTint="@color/lumation_accent"
                android:text="+ Media"
                android:textAllCaps="false"
                android:textColor="#141124" />
            <Button
                android:id="@+id/playButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="0.7"
                android:enabled="false"
                android:backgroundTint="@color/lumation_surface"
                android:text="▶ Play"
                android:textAllCaps="false"
                android:textColor="@color/lumation_text" />
            <Button
                android:id="@+id/exportButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:enabled="false"
                android:backgroundTint="#8266FC"
                android:text="Export MP4"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="22dp"
            android:paddingBottom="10dp"
            android:text="TIMELINE  •  VIDEO TRACK 01"
            android:textColor="@color/lumation_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <com.lumavun.lumation.TimelineView
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:background="@color/lumation_surface" />

        <TextView
            android:id="@+id/timeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingTop="8dp"
            android:text="00:00.0 / 00:00.0"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="TRIM CLIP"
            android:textColor="@color/lumation_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/startLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Mulai: 00:00.0"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/startSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />

        <TextView
            android:id="@+id/endLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selesai: 00:00.0"
            android:textColor="@color/lumation_muted"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/endSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="1000"
            android:progressTint="@color/lumation_accent"
            android:thumbTint="@color/lumation_accent" />

        <ProgressBar
            android:id="@+id/exportProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:indeterminateTint="@color/lumation_accent" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:text="Offline • Video diproses di perangkat • AI belum tersedia pada demo ini"
            android:textColor="@color/lumation_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
